    "Every track that plays stays here. When the cache is full, the tracks played longest ago go first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder gespielte Titel bleibt hier. Ist der Zwischenspeicher voll, gehen die am längsten nicht gespielten Titel zuerst."
          }
        }
      }
    },
