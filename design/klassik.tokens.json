      "inOut": {
        "$value": [
          0.42,
          0,
          0.58,
          1
        ]
      }
    },
    "transition": {
      "$type": "transition",
      "$description": "Reduce Motion replaces each with a cross-fade of motion.duration.quick.",
      "inPlace": {
        "$value": {
          "duration": "{motion.duration.quick}",
          "delay": {
            "value": 0,
            "unit": "ms"
          },
          "timingFunction": "{motion.easing.out}"
        },
        "$description": "A value that changes in place: a count, a label, a tint."
      },
      "open": {
        "$value": {
          "duration": "{motion.duration.standard}",
          "delay": {
            "value": 0,
            "unit": "ms"
          },
          "timingFunction": "{motion.easing.inOut}"
        },
        "$description": "A row that opens in place."
      },
      "rise": {
        "$value": {
          "duration": "{motion.duration.slow}",
          "delay": {
            "value": 0,
            "unit": "ms"
          },
          "timingFunction": "{motion.easing.inOut}"
        },
        "$description": "The next queue item rises into the player."
