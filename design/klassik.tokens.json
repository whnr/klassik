{
  "$description": "Klassik design tokens, DTCG 2025.10. Decided values only (ADR 0021). Type and spacing follow ADR 0030, colour ADR 0034. Radius, size and motion stay at neutral iOS system values until a look ticket decides.",
  "color": {
    "$type": "color",
    "background": {
      "page": {
        "$value": "{palette.light.background.page}",
        "$description": "Plain page: paper by day, the hall at night."
      },
      "row": {
        "$value": "{palette.light.background.row}",
        "$description": "A row of an inset list."
      },
      "grouped": {
        "$value": "{palette.light.background.grouped}",
        "$description": "Behind inset lists."
      },
      "elevated": {
        "$value": "{palette.light.background.elevated}",
        "$description": "A card or sheet above the page."
      }
    },
    "text": {
      "primary": {
        "$value": "{palette.light.text.primary}",
        "$description": "Ink."
      },
      "secondary": {
        "$value": "{palette.light.text.secondary}",
        "$description": "Facts, labels and placeholders."
      },
      "tertiary": {
        "$value": "{palette.light.text.tertiary}",
        "$description": "Disabled items only."
      }
    },
    "separator": {
      "$value": "{palette.light.separator}",
      "$description": "Lines between rows."
    },
    "fill": {
      "standard": {
        "$value": "{palette.light.fill.standard}",
        "$description": "A translucent overlay: controls, Chronology era bands."
      },
      "quiet": {
        "$value": "{palette.light.fill.quiet}",
        "$description": "A quieter translucent overlay: the search field, chips."
      }
    },
    "tint": {
      "$value": "{palette.light.tint}",
      "$description": "The accent: links, controls, the playing row, the played timeline."
    },
    "accent": {
      "fill": {
        "$value": "{palette.light.accent.fill}",
        "$description": "The accent as a fill behind a label: a filled button, a selected chip."
      }
    },
    "on-accent": {
      "$value": "{palette.light.on-accent}",
      "$description": "A label on the accent fill."
    },
    "favourite": {
      "$value": "{palette.light.favourite}",
      "$description": "The set fermata: the accent at its strongest chroma."
    },
    "favourite-off": {
      "$value": "{palette.light.favourite-off}",
      "$description": "The fermata when not set: a quiet grey."
    },
    "timeline": {
      "played": {
        "$value": "{palette.light.timeline.played}",
        "$description": "The played part of the timeline."
      },
      "unplayed": {
        "$value": "{palette.light.timeline.unplayed}",
        "$description": "The part of the timeline still to play."
      }
    },
    "swipe": {
      "playNext": {
        "$value": "{palette.light.swipe.playNext}",
        "$description": "Swipe action Play Next, with a white icon and label."
      },
      "addToQueue": {
        "$value": "{palette.light.swipe.addToQueue}",
        "$description": "Swipe action Add to Queue, with a white icon and label."
      },
      "download": {
        "$value": "{palette.light.swipe.download}",
        "$description": "Swipe action Download, with a white icon and label."
      },
      "favourite": {
        "$value": "{palette.light.swipe.favourite}",
        "$description": "Swipe action Favourite, with a white icon and label."
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "text": {
        "$value": [
          "-apple-system",
          "system-ui",
          "sans-serif"
        ],
        "$description": "The system face. In SwiftUI, a text style without a custom font."
      },
      "display": {
        "$value": [
          "Wittgenstein",
          "serif"
        ],
        "$description": "Page titles and section headings only. Bundled with the app under the SIL Open Font License 1.1."
      }
    }
  },
