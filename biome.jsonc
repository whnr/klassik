{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  // Biome lints the specimen's JS, the inline scripts in its pages included. Prettier formats it.
  "files": { "includes": ["design/**/*.js", "design/**/*.html"] },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "html": { "experimentalFullSupportEnabled": true },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        // The specimen styles each drawn view in its own block. Later blocks style other elements of the same type.
        "noDescendingSpecificity": "off",
        // Its fix can turn number addition into text; plain concatenation in short lines reads well.
        "useTemplate": "off"
      }
    }
  }
}
