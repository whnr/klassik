        }
      }
    },
    "This removes the favourite works, the listening notes, the recent searches and the changes that wait of this server and user from this iPhone. You cannot undo this.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das entfernt die Favoriten, die Hörnotizen, die letzten Suchen und die wartenden Änderungen dieses Servers und Benutzers von diesem iPhone. Du kannst das nicht rückgängig machen."
          }
        }
      }
    },
    "This track is larger than the Music limit. Raise the limit in Local Storage.": {
      "localizations": {
