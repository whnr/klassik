    "Downloads and the music cache leave this iPhone. Favourite works, listening notes and the changes that wait stay for this server and user.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads und der Musik-Zwischenspeicher verlassen dieses iPhone. Favoriten, Hörnotizen und wartende Änderungen bleiben für diesen Server und Benutzer."
          }
        }
      }
    },
    "Due for a New Check": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zur erneuten Prüfung fällig"
